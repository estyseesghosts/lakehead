# Example template for env-driven release signing.
#
# To activate real-keystore signing:
#   1. Copy this file to `keystore.properties` (gitignored).
#   2. Fill in real values; never commit `keystore.properties`.
#   3. Add the following to `app/build.gradle.kts`:
#
#        val keystorePropertiesFile = rootProject.file("keystore.properties")
#        val keystoreProperties = java.util.Properties().apply {
#            load(keystorePropertiesFile.inputStream())
#        }
#        signingConfigs {
#            create("release") {
#                keyAlias = keystoreProperties["keyAlias"] as String?
#                keyPassword = keystoreProperties["keyPassword"] as String?
#                storeFile = file(keystoreProperties["storeFile"] as String)
#                storePassword = keystoreProperties["storePassword"] as String?
#            }
#        }
#        buildTypes.getByName("release") {
#            signingConfig = signingConfigs.getByName("release")
#        }
#
# `keystore.properties`, `*.jks`, `*.keystore` are gitignored; see
# .gitignore.  AGENTS.md §7 forbids committing real secrets.

keyAlias=REPLACE_WITH_YOUR_KEY_ALIAS
keyPassword=REPLACE_WITH_YOUR_KEY_PASSWORD
storeFile=/absolute/path/to/your/upload.jks
storePassword=REPLACE_WITH_YOUR_STORE_PASSWORD