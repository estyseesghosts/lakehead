<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Feed overlay providers (values mirror platform:feed C1 constants
            FEED_OVERLAY_ACTION, LAWNFEED_PACKAGE, LAWNFEED_LEGACY_PACKAGE, NEO_FEED_PACKAGE).
            No extra permission: hosting binds the provider's exported overlay service with
            BIND_AUTO_CREATE and draws nothing itself, so no overlay or query permission is
            required. -->
        <intent>
            <action android:name="com.android.launcher3.WINDOW_OVERLAY" />
            <data android:scheme="app" />
        </intent>
        <package android:name="app.lawnchair.lawnfeed" />
        <package android:name="ch.deletescape.lawnchair.lawnfeed" />
        <package android:name="com.saulhdev.neofeed" />
    </queries>
</manifest>
